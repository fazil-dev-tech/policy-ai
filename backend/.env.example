# ============================================
# PolicyAI - Backend Environment Configuration
# ============================================

# Server
PORT=5000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=policy-files

# AI Provider Configuration (Primary: NVIDIA NIM Free Endpoint — Nemotron 3.5 / Ultra 550B / Super VL 120B)
# Supported: auto, nvidia, groq, gemini, puter, openai, grok
AI_PROVIDER=nvidia
AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_BASE_URL=
# Paid providers (openai, grok) remain disabled in fallback chains unless set to true:
AI_ALLOW_PAID=false
NVIDIA_API_KEY=
# Optional comma-separated multiple NVIDIA NIM keys for higher combined RPM rotation:
NVIDIA_API_KEYS=
# Optional Free-Tier Backups & Live Research / Threat Intel:
GROQ_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
VIRUSTOTAL_API_KEY=
ML_SERVICE_URL=http://127.0.0.1:8000
PUTER_AUTH_TOKEN=
# Optional Paid Keys (only used if AI_ALLOW_PAID=true or AI_PROVIDER=openai/grok):
OPENAI_API_KEY=
GROK_API_KEY=
GROK_API_BASE_URL=https://api.x.ai/v1

# SMTP / Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM=your_email@gmail.com
SMTP_SENDER_NAME=Team_WIE_Quantum_Coders

# Optional Redis Cache (falls back to in-memory cache if empty)
REDIS_URL=

# SMS (Twilio - Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# File Upload & Rate Limiting
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS & URLs
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=debug
LOG_DIR=logs
