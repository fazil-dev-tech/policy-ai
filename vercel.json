{
  "version": 2,
  "installCommand": "cd backend && npm install --omit=dev && cd ../frontend && npm install --include=dev --legacy-peer-deps",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!api/|policyguard-extension\\.zip|logo\\.png|assets/).*)", "destination": "/index.html" }
  ]
}
